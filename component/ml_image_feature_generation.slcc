id: ml_image_feature_generation
package: aiml
label: Image Feature Generator
description: >
  The image feature generator can be used to capture and preprocess features from an image
  to use with machine learning image classification or object detection applications. The camera
  is used as an image source and the features are calculated in real time.
category: Machine Learning|Feature Generator
quality: production
documentation:
  docset: machine-learning
  document: aiml-reference-guide
metadata:
  sbom:
    license: MSLA
provides:
  - name: ml_image_feature_generation
requires:
  - name: toolchain_gcc
    condition: [toolchain_gcc, device_efx]
  - name: toolchain_iar
    condition: [toolchain_iar, device_efx]
  - name: toolchain_llvm
    condition: [toolchain_llvm, device_efx]
  - name: cpp_support
  - name: arducam
  - name: sl_common
  - name: jlink_stream
config_file:
  - path: config/features/image/sl_ml_image_feature_generation_config.h
include:
  - path: inc/features/image
    file_list:
      - path: sl_ml_image_feature_generation.h
source:
  - path: src/features/image/sl_ml_image_feature_generation.cc
  - path: src/features/image/sl_ml_image_feature_generation_init.cc
  - path: config/features/image/sl_ml_image_feature_generation_config.cc
