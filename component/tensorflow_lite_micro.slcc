id: tensorflow_lite_micro
package: aiml
label: TensorFlow Lite Micro
description: >
  Embedded TensorFlow Lite Micro runtime for Silicon Labs applications: `sl_ml_model_handle_t`
  wraps codegen flatbuffer, resolver, and tensor arenas; load, invoke, and unload use
  `sl_ml_model_init`, `sl_ml_model_run`, and `sl_ml_model_deinit`. Public API and tensor
  helpers are declared in `sl_ml_tflite_micro_model.h`.

category: Machine Learning|TensorFlow
quality: production
documentation:
  docset: machine-learning
  document: aiml-reference-guide
metadata:
  sbom:
    id: tflite-micro
    license: Apache-2.0 AND MSLA
    upstream:
      name: Tensorflow Lite for Microcontrollers
      version: f5c36ef2efa9886d58b91106e28ab268cc725398
      supplier: The Tensorflow Authors
      url: https://github.com/tensorflow/tflite-micro
      package_url: pkg:github/tensorflow/tflite-micro@f5c36ef2efa9886d58b91106e28ab268cc725398
      comment: Tensorflow Lite for Microcontrollers library as it was on GitHub, at commit hash f5c36ef2efa9886d58b91106e28ab268cc725398
provides:
  - name: tensorflow_lite_micro
requires:
  - name: memory_manager
    condition: [device_efx]
include:
  - path: inc/tflite
    file_list:
      - path: sl_ml_tflite_micro_model.h
source:
  - path: src/tflite/sl_ml_tflite_micro_model.cc
template_contribution:
  - name: component_catalog
    value: tensorflow_lite_micro
define:
  - name: SL_BOARD_SI91X
    condition: [device_si91x]
toolchain_settings:
  - option: llvm_compiler_option
    value: -Wno-unknown-pragmas
    condition: [device_si91x]
  - option: iar_compiler_option
    value: --diag_suppress=Pe830 # placement new without matching operator delete in TFLM
