source:
  - path: src/tflite/sl_ml_tflite_micro_model.cc
    # this is needed to stay here for MicroPrintf to compile in the apps that need it, like profilers.
  - path: compiled_model/third_party/tflite_micro/tensorflow/lite/micro/micro_log.cc
  - path: compiled_model/third_party/tflite_micro/tensorflow/lite/micro/micro_interpreter_graph.cc
template_contribution:
  - name: component_catalog
    value: tensorflow_lite_micro
define:
  - name: SL_BOARD_SI91X
    condition:
      - device_si91x
  - name: TF_LITE_USE_GLOBAL_ROUND
  - name: TFLITE_SINGLE_ROUNDING
    value: 1
  - name: TF_LITE_STATIC_MEMORY
  - name: KERNELS_OPTIMIZED_FOR_SPEED
toolchain_settings:
  - option: gcc_compiler_option
    value: -Wno-unused-variable
  - option: gcc_compiler_option
    value: -Wno-unused-parameter
  - option: gcc_compiler_option
    value: -Wno-unused-function
  - option: gcc_compiler_option
    value: -Wno-maybe-uninitialized
  - option: gcc_compiler_option
    value: -Wno-unused-but-set-variable
  - option: llvm_compiler_option
    value: -Wno-unused-variable
  - option: llvm_compiler_option
    value: -Wno-unused-parameter
  - option: llvm_compiler_option
    value: -Wno-unused-function
  - option: llvm_compiler_option
    value: -Wno-uninitialized
  - option: llvm_compiler_option
    value: -Wno-unused-but-set-variable
  - option: llvm_compiler_option
    value: -Wno-unknown-warning-option
  - option: llvm_compiler_option
    value: -Wno-unknown-pragmas
    condition:
      - device_si91x

  # IAR diagnostics suppressed for imported TensorFlow Lite Micro sources:
  # Pa205  = controlling expression is constant
  # Pe550  = variable was set but never used
  # Pe1675 = type qualifiers on return type are meaningless
  # Pa093  = floating-point expression converted to integer
  # Pe611  = statement is unreachable
  # Pe177  = variable was declared but never referenced
  # Pe830  = missing return value from non-void function context / no return value expected mismatch
  # Pe111  = statement is unreachable because of control flow
  # Pa183  = #warning directive: IAR support is not tested
  - option: iar_compiler_option
    value: --diag_suppress=Pa205,Pe550,Pe1675,Pa093,Pe611,Pe177,Pe830,Pe111,Pa183
library:
  - path: lib/gcc/cortex-m33/libtflm.a
    condition:
      - toolchain_gcc
      - cortexm33
  - path: lib/gcc/cortex-m4/libtflm.a
    condition:
      - toolchain_gcc
      - cortexm4
  - path: lib/llvm/cortex-m33/libtflm.a
    condition:
      - toolchain_llvm
      - cortexm33
  - path: lib/llvm/cortex-m4/libtflm.a
    condition:
      - toolchain_llvm
      - cortexm4
  - path: lib/iar/cortex-m33/libtflm.a
    condition:
      - toolchain_iar
      - cortexm33
  - path: lib/iar/cortex-m4/libtflm.a
    condition:
      - toolchain_iar
      - cortexm4

