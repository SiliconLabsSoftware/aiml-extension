id: tensorflow_dependency_flatbuffers
package: aiml
label: Flatbuffers
description: >
  Flatbuffers library
category: Machine Learning|TensorFlow|Dependency
quality: production
documentation:
  docset: machine-learning
  document: aiml-reference-guide
metadata:
  sbom:
    license: Apache-2.0
    upstream:
      name: Flatbuffers
      version: v23.5.26
      supplier: Google Inc.
      url: https://github.com/google/flatbuffers/tree/v23.5.26
      comment: Only "include/" folder copied from Flatbuffers GitHub repo
      package_url: pkg:github/google/flatbuffers@0100f6a5779831fa7a651e4b67ef389a8752bd9b
root_path: third_party/flatbuffers
provides:
  - name: tensorflow_dependency_flatbuffers
# IAR DLIB has no usable <optional>;
define:
  - name: FLATBUFFERS_USE_STD_OPTIONAL
    value: 0
    condition: [toolchain_iar]
  - name: FLATBUFFERS_LOCALE_INDEPENDENT
    value: 0
  - name: FLATBUFFERS_PREFER_PRINTF
    value: 1
include:
  - path: include
    file_list:
      - path: flatbuffers/allocator.h
      - path: flatbuffers/array.h
      - path: flatbuffers/base.h
      - path: flatbuffers/buffer.h
      - path: flatbuffers/buffer_ref.h
      - path: flatbuffers/default_allocator.h
      - path: flatbuffers/detached_buffer.h
      - path: flatbuffers/flexbuffers.h
      - path: flatbuffers/flatbuffer_builder.h
      - path: flatbuffers/flatbuffers.h
      - path: flatbuffers/stl_emulation.h
      - path: flatbuffers/string.h
      - path: flatbuffers/struct.h
      - path: flatbuffers/table.h
      - path: flatbuffers/util.h
      - path: flatbuffers/vector.h
      - path: flatbuffers/vector_downward.h
      - path: flatbuffers/verifier.h
source: []
toolchain_settings:
  - option: iar_compiler_option
    value: --diag_suppress=Pe1675 # incompatible/suspicious type conversion in FlatBuffers (EWP)
  - option: iar_compiler_option
    value: --diag_suppress=Pa039 # Use of address of unaligned structure member
ui_hints:
  visibility: never
