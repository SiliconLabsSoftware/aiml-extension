project_name: aiml_soc_model_profiler_efr32
package: aiml_app
quality: production
label: AI/ML - SoC Model Profiler EFR32
description: >
  This application profiles a ML model. The ML model is loaded as a byte array
  which is generated from a Tensorflow tflite model file. Profiling is performed
  by running one inference with the model.
category: AI/ML Application
filter:
- name: Device Type
  value: [SoC]
- name: MCU
  value: [32-bit MCU]
- name: Project Difficulty
  value: [Advanced]
- name: Capability
  value: [Machine Learning]
include:
- path: .
  file_list:
  - path: app.h
  - path: model_profiler.h
  - path: energy_profiling_utils.hpp
source:
- path: app.c
- path: model_profiler.cc
component:
- id: ml_model
  instance:
  - soc_model_profiler
- id: sl_assert
- id: cpp_support
- id: sleeptimer
- id: clock_manager
- id: memory_manager
- id: sl_main
- id: device_init
- id: component_catalog
- id: iostream_retarget_stdio
- id: iostream_recommended_stream
- id: dma_manager
- id: dma_channel
- id: ml_profiler_utils
- id: nn_util

config_file:
- path: config/compiler/soc_model_profiler.mlconf
  directory: tflite
  override:
    component: ml_model
    file_id: ml_compiler_config
    instance: soc_model_profiler
- path: tflite_models/tflite/soc_model_profiler.tflite
  directory: tflite
define:
- name: TF_LITE_STATIC_MEMORY
- name: NDEBUG
- name: SL_ML_MODEL_PROFILER
- name: SL_ML_ENABLE_SILABS_PROFILER
- name: TFLITE_MICRO_LOGGER_ENABLED
  value: 1
- name: SUPPORT_CPLUSPLUS
  value: 1
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: 1
- name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
  value: 1
- name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
  value: 1
- name: SL_CLOCK_MANAGER_HFRCO_DPLL_EN
  value: 1
- name: SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE
  value: "SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE_HFRCODPLL"
toolchain_settings:
- option: gcc_linker_option
  value: -u _printf_float
- option: llvm_linker_option
  value: -u _printf_float
- option: llvm_compiler_option
  value: -Wno-implicit-exception-spec-mismatch
- option: llvm_compiler_option
  value: -Wno-unknown-warning-option
- option: llvm_compiler_option
  value: -Wno-unknown-pragmas
- option: llvm_compiler_option
  value: -Wno-vla-cxx-extension
- option: optimize
  value: speed
- option: gcc_compiler_option
  value: "-mfp16-format=ieee"
readme:
- path: readme.md
ui_hints:
  highlight: readme.md
tag:
- hardware:device:ram:64
- hardware:device:flash:400
sdk_extension:
- id: aiml
  vendor: silabs
  version: 3.0.1
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.1
