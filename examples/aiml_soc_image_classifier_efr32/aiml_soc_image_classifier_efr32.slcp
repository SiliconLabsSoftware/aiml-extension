project_name: aiml_soc_image_classifier_efr32
package: aiml_app
quality: production
label: AI/ML - SoC Image Classifier EFR32
description: >
  This application uses TensorFlow Lite for Microcontrollers to classify
  image captured on the camera. The classification results are displayed in VCOM serial port.
  Image data streamed over JLink using image feature generation component.
category: AI/ML Application
filter:
- name: Device Type
  value: [SoC]
- name: MCU
  value: [32-bit MCU]
- name: Project Difficulty
  value: [Advanced]
- name: Capability
  value: [Machine Learning]
include:
- path: .
  file_list:
  - path: app.h
  - path: image_classifier.h
  - path: recognize_commands.h
source:
- path: app.c
- path: image_classifier.cc
- path: recognize_commands.cc
component:
- id: ml_model
  instance:
  - rock_paper_scissors
- id: sl_main
- id: memory_manager
- id: i2cspm
  instance: [sensor]
- id: device_init
- id: ml_image_feature_generation
- id: printf
- id: iostream_recommended_stream
- id: iostream_retarget_stdio
- id: simple_led
  instance: [led0, led1]
- id: status
- id: device_init_hfrco
- id: sleeptimer
- id: cpp_support
- id: dma_manager
- id: dma_channel
config_file:
- path: config/compiler/rock_paper_scissors.mlconf
  directory: tflite
  override:
    component: ml_model
    file_id: ml_compiler_config
    instance: rock_paper_scissors
- path: config/image_classifier_config.h
- path: config/sl_spidrv_exp_config.h
- path: tflite_models/tflite/rock_paper_scissors.tflite
  directory: tflite
define:
- name: DEBUG_EFM
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: 1
- name: SL_MVP_POWER_MODE
  value: 1
- name: SL_ML_MODEL_INPUT_WIDTH
  value: 84
- name: SL_ML_MODEL_INPUT_HEIGHT
  value: 84
- name: SL_ML_CAM_IMAGE_WIDTH
  value: 96
- name: SL_ML_CAM_IMAGE_HEIGHT
  value: 96
- name: SL_ML_IMAGE_MEAN_THRESHOLD
  value: 50
- name: SL_ML_IMAGE_CROP_USE_LUT
  value: 0
  condition: [brd2601b]
- name: SL_SPIDRV_EXP_TX_PIN
  value: 3
  condition: [brd2601b]
- name: SL_SPIDRV_EXP_RX_PIN
  value: 2
  condition: [brd2601b]
- name: SL_SPIDRV_EXP_CLK_PIN
  value: 1
  condition: [brd2601b]
- name: SL_SPIDRV_EXP_CS_PORT
  value: "SL_GPIO_PORT_A"
  condition: [brd2601b]
- name: SL_SPIDRV_EXP_CS_PIN
  value: 7
  condition: [brd2601b]
toolchain_settings:
- option: gcc_linker_option
  value: -u _printf_float
- option: llvm_linker_option
  value: -u _printf_float
- option: llvm_compiler_option
  value: -Wno-implicit-exception-spec-mismatch
- option: gcc_compiler_option
  value: "-mfp16-format=ieee"
- option: llvm_compiler_option
  value: -Wno-unknown-warning-option
- option: llvm_compiler_option
  value: -Wno-unknown-pragmas
- option: llvm_compiler_option
  value: -Wno-vla-cxx-extension
readme:
- path: readme.md
ui_hints:
  highlight: readme.md
tag:
- hardware:component:led:2+
- hardware:device:ram:128
- hardware:device:flash:130
sdk_extension:
- id: aiml
  vendor: silabs
  version: 3.0.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.0
