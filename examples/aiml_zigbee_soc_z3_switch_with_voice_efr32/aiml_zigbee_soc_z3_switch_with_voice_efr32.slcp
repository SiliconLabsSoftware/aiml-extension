project_name: aiml_zigbee_soc_z3_switch_with_voice_efr32
label: AI/ML - SoC Z3SwitchWithVoice EFR32
package: aiml_app
category: AI/ML Application
quality: production
description: >
  Zigbee 3.0 Switch with Voice sample. Uses the Silicon Labs ML compiler(TensorFlow Lite Micro + MVP)
  for keyword spotting.
author: Silicon Laboratories, Inc.

component:
- id: ml_model
  instance:
  - keyword_spotting_on_off_v2
- id: sl_main
- id: cli
  instance:
  - example
- id: iostream_recommended_stream
- id: iostream_retarget_stdio
- id: printf
- id: sl_assert
- id: zigbee_debug_print
- id: zigbee_pro_leaf_stack
- id: zigbee_source_route
- id: zigbee_gp
- id: zigbee_r22_support
- id: zigbee_security_link_keys
- id: zigbee_zll
- id: zigbee_zcl_framework_core
- id: zigbee_zcl_cli
- id: zigbee_core_cli
- id: zigbee_basic
- id: zigbee_counters
- id: zigbee_end_device_support
- id: zigbee_find_and_bind_initiator
- id: zigbee_identify
- id: zigbee_groups_server
- id: zigbee_groups_client
- id: zigbee_interpan
- id: zigbee_network_creator
- id: zigbee_network_steering
- id: zigbee_scan_dispatch
- id: zigbee_scenes_client
- id: zigbee_update_tc_link_key
- id: zigbee_zll_commissioning_client
- id: zigbee_zll_commissioning_server
- id: zigbee_zll_commissioning_common
- id: zigbee_zll_scenes_client
- id: zigbee_zll_utility_client
- id: zigbee_zll_utility_server
- id: simple_led
  instance:
  - led0
- id: simple_button
  instance:
  - btn0
  - btn1
- id: zigbee_application_bootloader
- id: fe_audio
  instance:
  - keyword_spotting_on_off_v2
- id: power_manager
- id: clock_manager
- id: dma_manager
- id: dma_channel
define:
- name: DEBUG_EFM
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: 1
- name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
  value: usartHwFlowControlCtsAndRts
  condition:
  - iostream_usart
- name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
  value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS
  condition:
  - iostream_eusart
- name: SL_BOARD_ENABLE_SENSOR_MICROPHONE
  value: "1"
- name: SL_CLI_MAX_INPUT_ARGUMENTS
  value: 16
- name: SLI_ZIGBEE_PRIMARY_NETWORK_DEVICE_TYPE
  value: SLI_ZIGBEE_NETWORK_DEVICE_TYPE_END_DEVICE
- name: SLI_ZIGBEE_PRIMARY_NETWORK_SECURITY_TYPE
  value: SLI_ZIGBEE_NETWORK_SECURITY_TYPE_3_0
- name: SL_ZIGBEE_BINDING_TABLE_SIZE
  value: 10
- name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
  value: 0
  condition:
  - iostream_usart
- name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
  value: 0
  condition:
  - iostream_eusart
- name: SL_CLI_PROMPT_STRING
  value: '"zigbee_z3_switch_with_voice>"'
- name: NVM3_DEFAULT_NVM_SIZE
  value: 32768
  condition:
  - device_series_2
  # If using zigbee_secure_key_storage we do not need to support backwards
  # compatibility because we have never deployed images with keys in PSA
  # As a result, these lines end up saving some code space
- name: SL_PSA_ITS_SUPPORT_V1_DRIVER
  value: 0
- name: SL_PSA_ITS_SUPPORT_V2_DRIVER
  value: 0
- name: SL_PSA_ITS_SUPPORT_V3_DRIVER
  value: 1
- name: SL_MVP_OPTIMIZE_SPEED
  value: 1
  condition: [device_has_mvp]
source:
- path: app.c
- path: recognize_commands.cc
- path: keyword_detection.cc
- path: config/keyword_detection_config.cc
config_file:
- path: config/compiler/keyword_spotting_on_off_v2.mlconf
  directory: tflite
  override:
    component: ml_model
    file_id: ml_compiler_config
    instance: keyword_spotting_on_off_v2
- path: config/zcl/zcl_config.zap
  file_id: zap_configuration_file_id
  directory: zcl
- path: config/keyword_detection_config.h
- path: tflite_models/tflite/keyword_spotting_on_off_v2.tflite
  directory: tflite
toolchain_settings:
- option: gcc_linker_option
  value: -u _printf_float
- option: gcc_compiler_option
  value: "-Wno-unused-parameter"
- option: gcc_compiler_option
  value: -Wno-stringop-overflow
- option: gcc_compiler_option
  value: -Wno-stringop-overread
- option: llvm_linker_option
  value: -u _printf_float
- option: llvm_compiler_option
  value: -Wno-implicit-exception-spec-mismatch
- option: llvm_compiler_option
  value: -Wno-uninitialized
- option: llvm_compiler_option
  value: -Wno-format-security
- option: gcc_compiler_option
  value: "-mfp16-format=ieee"
- option: llvm_compiler_option
  value: -Wno-unknown-warning-option
- option: llvm_compiler_option
  value: -Wno-unknown-pragmas
- option: llvm_compiler_option
  value: -Wno-vla-cxx-extension
- option: iar_compiler_option
  value: --diag_suppress=Pa217   # mbedTLS PSA struct bit-field overlap warning
- option: llvm_compiler_option
  value: -Wno-unused-parameter
include:
- path: .
  file_list:
  - path: recognize_commands.h
  - path: keyword_detection.h
tag:
- prebuilt_demo
- hardware:component:led:1+
- hardware:component:microphone
- hardware:device:ram:56
- hardware:device:flash:130

readme:
- path: readme.md

ui_hints:
  highlight: readme.md

filter:
- name: Wireless Technology
  value: [Zigbee]
- name: Device Type
  value: [SoC]
- name: Capability
  value: [Machine Learning]
- name: Project Difficulty
  value: [Advanced]

sdk_extension:
- id: aiml
  vendor: silabs
  version: 3.0.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2
