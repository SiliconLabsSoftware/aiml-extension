project_name: aiml_wifi_soc_voice_control_light_siwg917_freertos
package: aiml_app
quality: experimental
label: AI/ML - SoC Wi-Fi Voice Control Light for SiWG917 (FreeRTOS)
category: AI/ML Application
description: |
  This application uses TensorFlow Lite for Microcontrollers on SiWx917 with Wi-Fi
  and FreeRTOS to detect the spoken words "on" and "off" from microphone audio.
  Detected keywords control an LED on the board and those detections are sent over wifi to a remote device
filter:
- name: Capability
  value: [Machine Learning]
- name: Device Type
  value: [SoC]
- name: MCU
  value: [32-bit MCU]
- name: Project Difficulty
  value:
  - Beginner
source:
- path: app.c
- path: app_ml_bridge.cc
- path: voice_control_light.cc
- path: recognize_commands.cc
- path: config/audio_classifier_config.cc
include:
- path: .
  file_list:
  - path: app.h
  - path: app_ml_bridge.h
  - path: voice_control_light.h
  - path: led_helper.hpp
  - path: mic_helper.hpp
  - path: recognize_commands.h
define:
- name: SUPPORT_CPLUSPLUS
  value: 1
component:
- id: ml_model
  instance:
  - keyword_spotting_on_off_v3
- id: sl_main
- id: sl_si91x_errno
- id: si91x_mem_config_3
- id: freertos
- id: freertos_heap_4
- id: syscalls
- id: wiseconnect_common
- id: wifi
- id: sl_si91x_mem_pool_buffers
  requires:
  - name: device_needs_ram_execution
    condition:
    - si91x_common_flash
- id: sl_si91x_internal_stack
- id: wifi_resources
- id: network_manager
- id: basic_network_config_manager
- id: bsd_socket
- id: sl_si91x_asynchronous_socket
- id: i2s_instance
  instance: [i2s0]
- id: sl_si91x_led_917
  instance: [led0]
- id: sleeptimer_si91x
- id: cmsis_dsp
- id: emlib_common
- id: cpp_support
- id: fe_audio
  instance:
  - keyword_spotting_on_off_v3
toolchain_settings:
- option: gcc_compiler_option
  value: -Wall -Werror
- option: gcc_compiler_option
  value: -Wno-unused-parameter
- option: gcc_compiler_option
  value: -Wno-missing-field-initializers
- option: gcc_linker_option
  value: -u _printf_float
- option: llvm_compiler_option
  value: -Wall -Werror
- option: llvm_linker_option
  value: -u _printf_float
- option: llvm_compiler_option
  value: -Wno-implicit-exception-spec-mismatch
- option: llvm_compiler_option
  value: -Wno-vla-cxx-extension
- option: llvm_compiler_option
  value: -Wno-missing-designated-field-initializers
- option: llvm_compiler_option   #TODO: remove this suppression after fix from platform
  value: -Wno-non-literal-null-conversion
- option: gcc_compiler_option
  value: "-mfp16-format=ieee"
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: 1
- name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
  value: 1
- name: SL_IOSTREAM_UART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
  value: 1
- name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
  value: 1
- name: SL_TFLITE_MICRO_ARENA_SIZE
  value: 2048
- name: SL_I2S0_SCLK_PIN
  value: 46
- name: SL_I2S0_WSCLK_PIN
  value: 47
- name: SL_I2S0_DIN0_PIN
  value: 48
- name: RTE_I2S0_DIN0_PORT_ID
  value: 2
- name: RTE_I2S0_SCLK_PORT_ID
  value: 2
- name: RTE_I2S0_WSCLK_PORT_ID
  value: 2
- name: DEFAULT_WIFI_AP_PROFILE_SSID
  value: "\"AIML_WIFI_SSID\""
- name: DEFAULT_WIFI_AP_CREDENTIAL
  value: "\"MY_AP_PASSPHRASE\""
config_file:
- path: config/compiler/keyword_spotting_on_off_v3.mlconf
  directory: tflite
  override:
    component: ml_model
    file_id: ml_compiler_config
    instance: keyword_spotting_on_off_v3
- path: config/audio_classifier_config.h
- path: tflite_models/tflite/keyword_spotting_on_off_v3.tflite
  directory: tflite
readme:
- path: readme.md
other_file: []
ui_hints:
  highlight:
  - path: readme.md
    focus: true
post_build:
- path: ../util/postbuild_profile/wiseconnect_soc.slpb
sdk_extension:
- id: aiml
  vendor: silabs
  version: 3.0.2
- id: wiseconnect3_sdk
  vendor: silabs
  version: 4.1.2
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.2
