model: blink.tflite

graph_optimizer:
  enabled: true

memory_optimizer:
  enabled: true

codegen:
  model_header:
    generate_micro_allocator_function: false

# Per-region overrides; merge with platform defaults. size: 0 removes a region.
memory_specification:
  - type: PagingBuffer
    size: 32768
    section: ".bss"
  - type: WeightsAndBiases2
    size: 0
