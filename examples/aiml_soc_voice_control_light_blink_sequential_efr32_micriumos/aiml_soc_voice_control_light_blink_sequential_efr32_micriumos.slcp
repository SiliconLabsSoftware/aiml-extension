project_name: aiml_soc_voice_control_light_blink_sequential_efr32_micriumos
package: aiml_app
quality: experimental
label: AI/ML - SoC Voice Control Light + Sine Blink sequential MicriumOS EFR32
description: >
  This application uses a keyword spotting model to detect the spoken words "on" and "off"
  from microphone audio in a MicriumOS kernel task. When "on" is detected, the firmware
  sequentially loads a sine blink model to drive LED0 with PWM for three cycles, then
  returns to keyword spotting while keeping only one model initialized in RAM at a time.
category: AI/ML Application
filter:
- name: Device Type
  value: [SoC]
- name: MCU
  value: [32-bit MCU]
- name: Project Difficulty
  value: [Advanced]
- name: Capability
  value: [Machine Learning]
include:
- path: .
  file_list:
  - path: app.h
  - path: voice_control_light.h
  - path: recognize_commands.h
source:
- path: app.c
- path: voice_control_light.cc
- path: recognize_commands.cc
- path: config/voice_control_light_config.cc
component:
- id: ml_model
  instance:
  - blink
- id: ml_model
  instance:
  - keyword_spotting_on_off
  condition: [device_compute_basic]
- id: ml_model
  instance:
  - keyword_spotting_on_off_v2
  condition: [device_has_mvp]
- id: sl_main
- id: memory_manager
- id: device_init
- id: clock_manager
- id: cpp_support
- id: fe_audio
  instance:
  - keyword_spotting_on_off_v2
- id: printf
- id: iostream_recommended_stream
- id: iostream_retarget_stdio
- id: pwm
  instance:
  - led0
- id: status
- id: micriumos_kernel
- id: power_manager
- id: sleeptimer
- id: dma_manager
- id: dma_channel
config_file:
- path: config/voice_control_light_config.h
- path: config/compiler/blink.mlconf
  directory: tflite
  override:
    component: ml_model
    file_id: ml_compiler_config
    instance: blink
- path: config/compiler/keyword_spotting_on_off.mlconf
  directory: tflite
  unless: [device_has_mvp]
  override:
    component: ml_model
    file_id: ml_compiler_config
    instance: keyword_spotting_on_off
- path: config/compiler/keyword_spotting_on_off_v2.mlconf
  directory: tflite
  condition: [device_has_mvp]
  override:
    component: ml_model
    file_id: ml_compiler_config
    instance: keyword_spotting_on_off_v2
- path: tflite_models/tflite/keyword_spotting_on_off.tflite
  directory: tflite
  unless: [device_has_mvp]
- path: tflite_models/tflite/keyword_spotting_on_off_v2.tflite
  directory: tflite
  condition: [device_has_mvp]
- path: tflite_models/tflite/blink.tflite
  directory: tflite
define:
- name: DEBUG_EFM
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: 1
- name: SL_BOARD_ENABLE_SENSOR_MICROPHONE
  value: 1
- name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
  value: 1
  condition: [iostream_usart]
- name: SL_IOSTREAM_UART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
  value: 1
  condition: [iostream_uart]
- name: SL_ML_AUDIO_FEATURE_GENERATION_AUDIO_BUFFER_SIZE
  value: 4096
- name: SL_ML_AUDIO_FEATURE_GENERATION_AUDIO_GAIN
  value: 2
- name: SL_HEAP_SIZE
  value: 0x2000
- name: SL_MVP_OPTIMIZE_SPEED
  value: 1
  condition: [device_has_mvp]
toolchain_settings:
- option: llvm_compiler_option
  value: -Wno-implicit-exception-spec-mismatch
- option: gcc_compiler_option
  value: "-mfp16-format=ieee"
- option: llvm_compiler_option
  value: -Wno-unknown-warning-option
- option: llvm_compiler_option
  value: -Wno-unknown-pragmas
- option: llvm_compiler_option
  value: -Wno-vla-cxx-extension
readme:
- path: readme.md
ui_hints:
  highlight: readme.md
tag:
- hardware:component:led:1+
- hardware:component:microphone
- hardware:device:ram:128
- hardware:device:flash:130
sdk_extension:
- id: aiml
  vendor: silabs
  version: 3.0.0
sdk:
  id: simplicity_sdk
  vendor: silabs
  version: 2026.6.0
